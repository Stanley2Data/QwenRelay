# Docker Compose reads this file after you copy it to .env.
# Native start scripts use exported variables/CLI flags; they do not source it.
MODEL_ASSET_DIR=/absolute/path/to/models
TP=1
CUDA_VISIBLE_DEVICES=0
PORT=18020
# Native-only optional inputs:
# MODELS_ROOT=/absolute/path/to/models
# BIND_HOST=127.0.0.1
# API_KEY_FILE=/absolute/path/to/api_key.txt
# QWENRELAY_PYTHON=/absolute/path/to/.venv/bin/python

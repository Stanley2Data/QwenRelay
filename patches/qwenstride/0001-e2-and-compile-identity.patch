+def _align_candidate_to_primary_block(
+    spec: AttentionSpec,
+    primary_block: int,
+    max_page_size: int,
+    covering_block: int,
+    name: str,
+) -> KVCacheSpec | None:
+    """E2 fallback: raise draft block to the primary, then page-pad.
+
+    The original promote path requires a covering block that already exceeds
+    max_page_size and divides the primary block. When the covering block is
+    larger than the primary (E0 272B: covering 832 vs primary 800), that
+    search is empty and the engine keeps draft block=16, padding each
+    16-token page to the full target page (about 2 percent useful bytes).
+
+    If VLLM_KV_PROMOTE_ALIGN_PRIMARY=1, instead set block_size to the
+    existing primary (scheduler LCM stays the primary) and pad only the
+    remaining few percent via page_size_padded. Default off.
+    """
+    if os.environ.get("VLLM_KV_PROMOTE_ALIGN_PRIMARY", "").strip() != "1":
+        return None
+    if covering_block <= primary_block:
+        return None
+    if isinstance(spec, MLAAttentionSpec) or spec.tokens_per_state != 1:
+        return None
+    if spec.block_size <= 0 or primary_block % spec.block_size != 0:
+        return None
+    aligned = replace(spec, block_size=primary_block)
+    natural = aligned.unpadded_page_size_bytes
+    if natural <= 0 or natural >= max_page_size:
+        return None
+    padded = replace(aligned, page_size_padded=max_page_size)
+    pad_pct = 100.0 * (max_page_size - natural) / max_page_size
+    logger.info(
+        "Aligning %s block %d -> primary %d; natural page %d B padded to %d B "
+        "(covering %d > primary; pad %.2f%%).",
+        name,
+        spec.block_size,
+        primary_block,
+        natural,
+        max_page_size,
+        covering_block,
+        pad_pct,
+    )
+    return padded
+

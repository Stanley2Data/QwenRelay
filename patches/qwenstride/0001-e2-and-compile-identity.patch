+"""INT8 per-token-head physical layout: C/D0/E0 share one plumbing.
+
+logical_hs = 256
+scale_bytes = 4
+tail_pad_bytes in {0, 4, 12}
+physical_hs = logical_hs + scale_bytes + tail_pad_bytes
+
+C   pad=0  -> 260B + int32 reader
+D0  pad=4  -> 264B + int32 reader
+E0  pad=12 -> 272B + native tl.load  (VLLM_INT8_KV_PAD16=1)
+
+Scale always at +logical_hs (256). Padding is never scale.
+Draft head_size=128 stays 132B (no tail pad).
+Default OFF: PAD16 unset, tail pad 0.
+"""
+from __future__ import annotations
+
+import os
+
+INT8_SCALE_BYTES = 4
+TARGET_FA_HEAD_SIZE = 256
+DRAFT_HEAD_SIZE = 128
+TAIL_PAD_ALLOWED = (0, 4, 12)
+
+
+def _env_flag(name: str) -> bool:
+    return os.environ.get(name, "").strip() == "1"
+
+
+def pad16_enabled() -> bool:
+    return _env_flag("VLLM_INT8_KV_PAD16")
+
+
+def target_tail_pad_bytes() -> int:
+    if pad16_enabled():
+        return 12
+    raw = os.environ.get("VLLM_INT8_TARGET_TAIL_PAD", "0").strip()
+    try:
+        n = int(raw)
+    except ValueError:
+        n = 0
+    return n if n in TAIL_PAD_ALLOWED else 0
+
+
+def load_i32_enabled() -> bool:
+    if pad16_enabled():
+        return False
+    return _env_flag("VLLM_SPEC_ATTN_I32_LOAD")
+
+
+def load_i64_enabled() -> bool:
+    if pad16_enabled():
+        return False
+    return _env_flag("VLLM_SPEC_ATTN_I64_LOAD")
+
+
+def int8_head_phys_bytes(head_size: int, *, tail_pad: int | None = None) -> int:
+    pad = target_tail_pad_bytes() if tail_pad is None else tail_pad
+    if head_size != TARGET_FA_HEAD_SIZE:
+        pad = 0
+    if pad not in TAIL_PAD_ALLOWED:
+        pad = 0
+    return head_size + INT8_SCALE_BYTES + pad
+
+
+def int8_scale_byte_offset(head_size: int) -> int:
+    return head_size
+
+
+def expected_half_elements(head_size: int, dtype_sz: int, *, tail_pad: int | None = None) -> int:
+    phys = int8_head_phys_bytes(head_size, tail_pad=tail_pad)
+    if phys % dtype_sz != 0:
+        raise ValueError(f"physical head {phys} not divisible by dtype {dtype_sz}")
+    return phys // dtype_sz
+
+
+def carve_int8_scale_views(kv_cache, head_size: int, *, tail_pad: int | None = None):
+    """Strided FP32 views at +head_size, never padded_hs-4."""
+    import torch
+
+    num_blocks, nkv, block_size, content = kv_cache.shape
+    dtype_sz = kv_cache.element_size()
+    if dtype_sz != 1:
+        raise ValueError("INT8 scale layout requires one-byte storage")
+    padded_hs = content // 2
+    expected = expected_half_elements(head_size, dtype_sz, tail_pad=tail_pad)
+    if padded_hs != expected:
+        raise ValueError(
+            f"INT8 KV half width {padded_hs} != expected {expected} "
+            f"(head_size={head_size}, dtype_sz={dtype_sz})"
+        )
+    hs_elems = head_size
+    raw = kv_cache.untyped_storage()
+    base_f32 = torch.tensor([], dtype=torch.float32, device=kv_cache.device).set_(raw)
+
+    def to_f32_units(elements: int) -> int:
+        nbytes = elements * dtype_sz
+        if nbytes % 4 != 0:
+            raise ValueError("scale view requires 4-byte alignment")
+        return nbytes // 4
+
+    strides = kv_cache.stride()
+    block_f32 = to_f32_units(strides[0])
+    head_f32 = to_f32_units(strides[1])
+    slot_f32 = to_f32_units(strides[2])
+    base_off_f32 = to_f32_units(kv_cache.storage_offset())
+    k_scale_off_f32 = base_off_f32 + to_f32_units(hs_elems)
+    v_scale_off_f32 = base_off_f32 + to_f32_units(padded_hs + hs_elems)
+    k_scale = torch.as_strided(
+        base_f32,
+        size=(num_blocks, block_size, nkv),
+        stride=(block_f32, slot_f32, head_f32),
+        storage_offset=k_scale_off_f32,
+    )
+    v_scale = torch.as_strided(
+        base_f32,
+        size=(num_blocks, block_size, nkv),
+        stride=(block_f32, slot_f32, head_f32),
+        storage_offset=v_scale_off_f32,
+    )
+    return k_scale, v_scale

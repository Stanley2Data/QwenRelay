+def _spec_attn_prepare(impl, max_reqs, device):
+    """Fix scratch capacity during model load, while scheduler config is bound.
+
+    The V2 worker calls attention later without a current VllmConfig. The old
+    lazy helper silently allocated for 256 requests in that context. Allocate
+    for the real scheduler capacity before capture; graph buffer addresses and
+    kernel math remain fixed for the life of this worker.
+    """
+    from vllm.v1.attention.ops.spec_decode_attn import SpecDecodeAttention
+
+    key = (impl.num_heads, impl.head_size, device)
+    att = _SPEC_ATTN.get(key)
+    if att is None:
+        att = SpecDecodeAttention(
+            max_reqs, impl.num_heads, impl.head_size, device,
+            qmax=_spec_attn_qmax(impl.num_heads // impl.num_kv_heads),
+        )
+        _SPEC_ATTN[key] = att
+    if att.max_num_reqs < max_reqs:
+        raise ValueError("split-KV scratch is smaller than scheduler max_num_seqs")
+    return att
+

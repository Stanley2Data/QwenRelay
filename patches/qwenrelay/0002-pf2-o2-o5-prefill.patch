+"""Opt-in, keyword-only prefill dispatch; all other calls keep 0.31 native code."""
+import functools
+import inspect
+import os
+
+
+def wrap(native):
+    parameters = inspect.signature(native).parameters
+    required = frozenset(n for n, p in parameters.items() if p.default is p.empty)
+    supported = frozenset(parameters)
+
+    @functools.wraps(native)
+    def dispatch(*args, **kwargs):
+        if (args or os.environ.get('QWEN_PF2') != '1'
+                or kwargs.get('o5_fallback_only', False)
+                or not required.issubset(kwargs) or not kwargs.keys() <= supported):
+            return native(*args, **kwargs)
+        from . import o2, o5, pf2
+        if o5.try_run(kwargs, native):
+            return
+        if o2.try_run(kwargs):
+            return
+        if pf2.try_run(kwargs):
+            return
+        return native(*args, **kwargs)
+    return dispatch

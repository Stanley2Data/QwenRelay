+        alpha = tl.exp2(maximum - new_max)
+        denominator = denominator * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot((p * sv[None, :]).to(tl.bfloat16), v)
+        maximum = new_max
+    tl.store(O + qi[:, None] * O0 + head * O1 + dd[None, :],
+             acc / denominator[:, None], qi[:, None] < T)
+
+
+@triton.jit
+def integer_dot_test(A, B, C, ROWS: tl.constexpr = 32, COLS: tl.constexpr = 64):
+    rr = tl.arange(0, ROWS)
+    dd = tl.arange(0, 256)
+    cc = tl.arange(0, COLS)
+    a = tl.load(A + rr[:, None] * 256 + dd[None, :])
+    b = tl.load(B + cc[None, :] * 256 + dd[:, None])
+    c = tl.dot(a, b, out_dtype=tl.int32)
+    tl.store(C + rr[:, None] * COLS + cc[None, :], c)

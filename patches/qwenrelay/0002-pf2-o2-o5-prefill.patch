+"""O2 arithmetic-only dense prototype; no serving patch or codec change.
+
+M32/B32, causal masking, FP32 online softmax, and BF16(P*sV) PV stay
+matched to the frozen production PF2. Q scale is FP32 per query/head.
+"""
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def quantize_rows(x):
+    maximum = tl.max(tl.abs(x.to(tl.float32)), 1)
+    scale = tl.where(maximum > 0., tl.div_rn(maximum, 127.), 1.)
+    normalized = tl.div_rn(x.to(tl.float32), scale[:, None])
+    rounded = tl.inline_asm_elementwise(
+        "cvt.rni.s32.f32 $0, $1;", constraints="=r,f",
+        args=[normalized], dtype=tl.int32, is_pure=True, pack=1)
+    code = tl.minimum(tl.maximum(rounded, -127), 127).to(tl.int8)
+    return code, scale
+
+
+@triton.jit
+def quantize(Q, QC, QS, T: tl.constexpr, HQ: tl.constexpr,
+             Q0: tl.constexpr, Q1: tl.constexpr, M: tl.constexpr = 32):
+    qi = tl.program_id(0) * M + tl.arange(0, M)
+    head = tl.program_id(1)
+    dd = tl.arange(0, 256)
+    x = tl.load(Q + qi[:, None] * Q0 + head * Q1 + dd[None, :], qi[:, None] < T, 0)
+    code, scale = quantize_rows(x)
+    tl.store(QC + (qi[:, None] * HQ + head) * 256 + dd[None, :], code, qi[:, None] < T)
+    tl.store(QS + qi * HQ + head, scale, qi < T)
+
+
+@triton.jit
+def attention(Q, QC, QS, K, V, KS, VS, O, L,
+              T: tl.constexpr, HQ: tl.constexpr, HK: tl.constexpr,
+              Q0: tl.constexpr, Q1: tl.constexpr,
+              O0: tl.constexpr, O1: tl.constexpr,
+              INLINE: tl.constexpr, M: tl.constexpr = 32,
+              B: tl.constexpr = 32):
+    qi = tl.program_id(0) * M + tl.arange(0, M)
+    head = tl.program_id(1)
+    kh = head // (HQ // HK)
+    dd = tl.arange(0, 256)
+    kk = tl.arange(0, B)
+    n = tl.load(L)
+    if INLINE:
+        original = tl.load(Q + qi[:, None] * Q0 + head * Q1 + dd[None, :], qi[:, None] < T, 0)
+        q, sq = quantize_rows(original)
+    else:
+        q = tl.load(QC + (qi[:, None] * HQ + head) * 256 + dd[None, :], qi[:, None] < T, 0)
+        sq = tl.load(QS + qi * HQ + head, qi < T, 1.)
+    acc = tl.zeros((M, 256), tl.float32)
+    maximum = tl.full((M,), float('-inf'), tl.float32)
+    denominator = tl.zeros((M,), tl.float32)
+    end = tl.minimum(n, n - T + (tl.program_id(0) + 1) * M)
+    for block in range(0, tl.cdiv(end, B)):
+        pos = block * B + kk
+        k = tl.load(K + (pos[None, :] * HK + kh) * 256 + dd[:, None], pos[None, :] < n, 0)
+        v = tl.load(V + (pos[:, None] * HK + kh) * 256 + dd[None, :], pos[:, None] < n, 0).to(tl.bfloat16)
+        sk = tl.load(KS + pos * HK + kh, pos < n, 0.)
+        sv = tl.load(VS + pos * HK + kh, pos < n, 0.)
+        integer_dot = tl.dot(q, k, out_dtype=tl.int32)
+        score = integer_dot.to(tl.float32) * (sq[:, None] * ((0.0625 * 1.4426950408889634) * sk[None, :]))
+        mask = (pos[None, :] <= n - T + qi[:, None]) & (pos[None, :] < n) & (qi[:, None] < T)
+        score = tl.where(mask, score, float('-inf'))
+        new_max = tl.maximum(maximum, tl.max(score, 1))

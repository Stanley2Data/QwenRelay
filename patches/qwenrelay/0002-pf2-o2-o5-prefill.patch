+def gather_sequence(K,V,KS,VS,BT,DK,DV,DKS,DVS,L,CU,STATS,SEQ:tl.constexpr,USE_INT8:tl.constexpr,PAGE:tl.constexpr,BT0:tl.constexpr,S0:tl.constexpr,S1:tl.constexpr,S2:tl.constexpr,T0:tl.constexpr,T1:tl.constexpr,T2:tl.constexpr,BLOCK:tl.constexpr=32):
